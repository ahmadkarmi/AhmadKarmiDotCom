---
// "Results That Speak" metrics row.
//
// Built exactly like the Lab and Insights rows on the homepage (same
// scroller, same snap wrapper and widths, same card shell as WorkCard.astro),
// because those rows swipe reliably on iPhone and earlier variants of this
// one did not (see memory: iOS swipe-row gotcha).
//
// Motion rules that keep it that way:
// - Only SVG internals animate (stroke-dashoffset, SVG transforms). No card
//   or wrapper is ever transformed, faded or given an overlay.
// - Below xl the row is a swiper, so every animation is one-shot and ends
//   static. The only looping effect (end-point pulse) is xl-only, where the
//   row is a plain grid.
// - The finished charts are the default render. The script only "arms" the
//   start state when the row is still off screen, so no-JS and reduced-motion
//   visitors simply see the final charts.

const metrics = [
  { value: '23%', label: 'Daily Revenue Increase', context: 'AI-driven personalization', chart: 'area' },
  { value: '90%+', label: 'Search Conversion Rate', context: 'Optimized discovery flows', chart: 'gauge' },
  { value: '70%', label: 'Engagement Boost', context: 'Gamification strategies', chart: 'bars' },
  { value: '36.1%', label: 'Event Conversion', context: 'AI-driven campaigns', chart: 'funnel' },
];

// Weekly engagement bars for the 70% card: three weeks before launch, four after.
const bars = [
  { h: 22, after: false }, { h: 26, after: false }, { h: 24, after: false },
  { h: 36, after: true }, { h: 42, after: true }, { h: 47, after: true }, { h: 52, after: true },
];
---

<!-- Snapping: each card rests against the left gutter (snap-start with a
     matching scroll-pl-4), App Store style (a strong flick can travel several
     cards; snap-always was tried and felt sticky), and the row
     never hands a sideways overscroll to the page. Centre snapping left the
     first and last cards unable to reach their snap point, so iOS settled
     inconsistently near the ends. -->
<div class="flex overflow-x-auto overscroll-x-contain snap-x snap-mandatory scroll-pl-4 gap-6 pb-8 -mx-4 px-4 xl:grid xl:grid-cols-4 xl:gap-8 xl:pb-0 xl:mx-0 xl:px-0 no-scrollbar" data-drag-scroll data-mb-row>
  {metrics.map((metric, index) => (
    <div class="min-w-[85vw] sm:min-w-[70vw] md:min-w-[55vw] lg:min-w-[45vw] xl:min-w-0 snap-start">
      <!-- Whole card is a swipe surface: pans are always scroll gestures, no
           text selection, and the hover lift/shadow only applies on devices
           that really hover (iOS otherwise applies :hover on touch, moving
           the card mid-swipe). -->
      <article class="group relative flex flex-col w-full aspect-square bg-white border border-border rounded-lg shadow-sm transition-all duration-300 overflow-hidden select-none touch-pan-x touch-pan-y [@media(hover:hover)]:hover:shadow-md [@media(hover:hover)]:hover:-translate-y-1">
        <!-- Card Header: key and context, matching WorkCard -->
        <div class="px-4 py-3 flex items-center justify-between border-b border-border/40 bg-background-secondary/5">
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4V4zm2 2v12h12V6H6z"/></svg>
            <span class="text-xs font-mono text-foreground-muted font-medium">KPI-0{index + 1}</span>
          </div>
          <span class="text-[10px] uppercase font-bold text-foreground-muted">{metric.context}</span>
        </div>

        <!-- Card Body -->
        <div class="p-4 flex flex-col flex-1 min-h-0">
          <div class="text-4xl lg:text-5xl font-display font-bold text-accent mb-2 tracking-tight tabular-nums">
            {metric.value}
          </div>
          <h3 class="font-display font-bold text-xl text-foreground mb-4 leading-tight [@media(hover:hover)]:group-hover:text-accent transition-colors">
            {metric.label}
          </h3>

          <!-- Data viz graphic -->
          <div class="flex-1 min-h-[64px] w-full mt-2 text-accent pointer-events-none">
            {metric.chart === 'area' && (
              <svg viewBox="0 0 200 90" class="w-full h-full overflow-visible" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="mb-area-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0.28" />
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                  </linearGradient>
                </defs>
                <g class="text-border" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke">
                  <line x1="0" y1="22" x2="200" y2="22" vector-effect="non-scaling-stroke" />
                  <line x1="0" y1="46" x2="200" y2="46" vector-effect="non-scaling-stroke" />
                  <line x1="0" y1="70" x2="200" y2="70" vector-effect="non-scaling-stroke" />
                </g>
                <path class="mb-fade" style="--d: 0.5s" d="M2 76 C 30 74, 44 50, 68 50 S 106 64, 128 46 S 166 20, 194 14 L 194 90 L 2 90 Z" fill="url(#mb-area-fill)" />
                <!-- No vector-effect here: non-scaling-stroke breaks pathLength
                     dash maths in WebKit and the line stopped part way. -->
                <path class="mb-draw" pathLength="1" d="M2 76 C 30 74, 44 50, 68 50 S 106 64, 128 46 S 166 20, 194 14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                <circle class="mb-pulse" cx="194" cy="14" r="6" fill="currentColor" fill-opacity="0.3" />
                <circle class="mb-fade" style="--d: 1.3s" cx="194" cy="14" r="3.5" fill="white" stroke="currentColor" stroke-width="2" />
              </svg>
            )}
            {metric.chart === 'gauge' && (
              <svg viewBox="0 0 200 110" class="w-full h-full" aria-hidden="true">
                <path d="M30 100 A70 70 0 0 1 170 100" fill="none" stroke="currentColor" stroke-opacity="0.12" stroke-width="16" stroke-linecap="round" />
                <path class="mb-gauge" pathLength="100" d="M30 100 A70 70 0 0 1 170 100" fill="none" stroke="currentColor" stroke-width="16" stroke-linecap="round" />
                <g stroke="currentColor" stroke-opacity="0.35" stroke-width="2" stroke-linecap="round">
                  <line x1="100" y1="16" x2="100" y2="24" />
                  <line x1="40.6" y1="40.6" x2="46.3" y2="46.3" />
                  <line x1="159.4" y1="40.6" x2="153.7" y2="46.3" />
                </g>
              </svg>
            )}
            {metric.chart === 'bars' && (
              <svg viewBox="0 0 200 90" class="w-full h-full" aria-hidden="true">
                <line x1="0" y1="82" x2="200" y2="82" class="text-border" stroke="currentColor" stroke-width="1" />
                <line x1="91" y1="10" x2="91" y2="82" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.5" stroke-dasharray="3 4" />
                <circle cx="91" cy="10" r="3" fill="currentColor" />
                {bars.map((bar, i) => (
                  <rect
                    class="mb-grow-y"
                    style={`--d: ${0.15 + i * 0.08}s`}
                    x={10 + i * 27}
                    y={82 - bar.h}
                    width="18"
                    height={bar.h}
                    rx="3"
                    fill="currentColor"
                    fill-opacity={bar.after ? 1 : 0.22}
                  />
                ))}
              </svg>
            )}
            {metric.chart === 'funnel' && (
              <svg viewBox="0 0 200 90" class="w-full h-full" aria-hidden="true">
                <rect class="mb-grow-x" style="--d: 0.1s" x="4" y="6" width="192" height="20" rx="5" fill="currentColor" fill-opacity="0.14" />
                <rect class="mb-grow-x" style="--d: 0.3s" x="34" y="34" width="132" height="20" rx="5" fill="currentColor" fill-opacity="0.38" />
                <rect class="mb-grow-x" style="--d: 0.5s" x="65" y="62" width="70" height="20" rx="5" fill="currentColor" />
                <circle class="mb-pulse" cx="100" cy="72" r="10" fill="currentColor" fill-opacity="0.25" />
              </svg>
            )}
          </div>
        </div>
      </article>
    </div>
  ))}
</div>

<style>
  /* Final chart state is the default. The script below only adds
     data-mb-armed while the row is off screen, then removes it so every
     transition plays once from the armed start state to this final one. */
  .mb-draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s);
  }
  .mb-gauge {
    stroke-dasharray: 100;
    stroke-dashoffset: 10;
    transition: stroke-dashoffset 1.3s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0.1s);
  }
  .mb-fade {
    opacity: 1;
    transition: opacity 0.8s ease-out var(--d, 0s);
  }
  .mb-grow-y,
  .mb-grow-x {
    transform-box: fill-box;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s);
  }
  .mb-grow-y { transform-origin: 50% 100%; }
  .mb-grow-x { transform-origin: 50% 50%; }

  [data-mb-row][data-mb-instant] :is(.mb-draw, .mb-gauge, .mb-fade, .mb-grow-y, .mb-grow-x) { transition: none; }
  [data-mb-row][data-mb-armed] .mb-draw { stroke-dashoffset: 1; }
  [data-mb-row][data-mb-armed] .mb-gauge { stroke-dashoffset: 100; }
  [data-mb-row][data-mb-armed] .mb-fade { opacity: 0; }
  [data-mb-row][data-mb-armed] .mb-grow-y { transform: scaleY(0); }
  [data-mb-row][data-mb-armed] .mb-grow-x { transform: scaleX(0); }

  /* The one looping effect, only where the row is a static grid (xl+). */
  .mb-pulse { opacity: 0; }
  @media (min-width: 1280px) and (prefers-reduced-motion: no-preference) {
    .mb-pulse {
      transform-box: fill-box;
      transform-origin: center;
      animation: mb-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes mb-pulse {
    0% { opacity: 0.6; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(2.2); }
  }
</style>

<script>
  // One-shot chart reveal. Arms the start state only while the row is below
  // the viewport and releases it once when the row scrolls into view.
  function initMetricCharts() {
    const row = document.querySelector<HTMLElement>('[data-mb-row]');
    if (!row || row.dataset.mbBound) return;
    row.dataset.mbBound = 'true';
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) return;
    if (row.getBoundingClientRect().top < window.innerHeight * 0.9) return;

    // Jump to the start state without transitioning to it, then re-enable
    // transitions so only the reveal itself animates.
    row.dataset.mbInstant = '';
    row.dataset.mbArmed = '';
    void row.offsetWidth;
    delete row.dataset.mbInstant;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        observer.disconnect();
        requestAnimationFrame(() => delete row.dataset.mbArmed);
      },
      { threshold: 0.35 }
    );
    observer.observe(row);
  }

  // astro:page-load fires on the first load and after every client navigation.
  document.addEventListener('astro:page-load', initMetricCharts);
</script>

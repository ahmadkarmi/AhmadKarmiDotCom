---
// "Results That Speak" metrics: a swipe row on phones, a grid from md up.
//
// Plain server-rendered markup, deliberately. This used to be a React island
// (client:visible) animating each card with framer-motion. On iPhone that row
// would not scroll at all, while the Lab and Insights rows built from the
// same classes as static Astro markup scrolled fine. Rendering it the same
// way as those rows removes the island and framer-motion from the homepage.
// The reveal and count-up are progressive enhancement in lib/metricBento.ts:
// the figures and cards are fully visible without JavaScript.

const metrics = [
  { value: '23%', label: 'Daily Revenue Increase', context: 'AI-driven personalization', chart: 'area' },
  { value: '90%+', label: 'Search Conversion Rate', context: 'Optimized discovery flows', chart: 'bars' },
  { value: '70%', label: 'Engagement Boost', context: 'Gamification strategies', chart: 'dots' },
  { value: '36.1%', label: 'Event Conversion', context: 'AI-driven campaigns', chart: 'line' },
];
---

<div
  class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-8 -mx-4 px-4 md:grid md:grid-cols-2 lg:grid-cols-4 md:gap-6 md:pb-0 md:mx-0 md:px-0 no-scrollbar"
  data-drag-scroll
  data-metrics-row
>
  {metrics.map((metric, index) => (
    <!-- Plain snap wrapper, as in the Lab and Insights rows. Tested on a real
         iPhone: the row only swipes with the card inside a wrapper and with
         the motion, hover overlay and partial opacity limited to md+. -->
    <div class="min-w-[70vw] md:min-w-0 snap-center">
    <div
      class="metric-card relative group overflow-hidden rounded-2xl bg-white border border-border p-6 hover:shadow-xl hover:shadow-accent/5 flex flex-col justify-between h-[280px]"
      style={`--i: ${index}`}
    >
      <div class="relative z-10">
        <div class="text-4xl lg:text-5xl font-display font-bold text-accent mb-2 tracking-tight">
          <span class="tabular-nums" data-count-to={metric.value}>{metric.value}</span>
        </div>
        <h3 class="text-lg font-medium text-foreground mb-2 leading-tight">{metric.label}</h3>
        <p class="text-sm text-foreground-secondary group-hover:text-accent transition-colors duration-300">
          {metric.context}
        </p>
      </div>

      <!-- Data viz graphic -->
      <div class="mt-auto h-16 w-full md:opacity-60 md:group-hover:opacity-100 group-hover:scale-105 transition-all duration-500">
        {metric.chart === 'area' && (
          <svg viewBox="0 0 100 40" class="w-full h-full text-accent/20" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 35 C 20 35, 20 10, 40 10 S 60 25, 80 5 L 100 0 L 100 40 L 0 40 Z" fill="currentColor" />
            <path d="M0 35 C 20 35, 20 10, 40 10 S 60 25, 80 5 L 100 0" fill="none" stroke="currentColor" stroke-width="2" class="text-accent" />
          </svg>
        )}
        {metric.chart === 'bars' && (
          <svg viewBox="0 0 100 40" class="w-full h-full" preserveAspectRatio="none" aria-hidden="true">
            <rect x="10" y="20" width="15" height="20" class="fill-accent/20" rx="2" />
            <rect x="35" y="10" width="15" height="30" class="fill-accent/40" rx="2" />
            <rect x="60" y="15" width="15" height="25" class="fill-accent/60" rx="2" />
            <rect x="85" y="5" width="15" height="35" class="fill-accent" rx="2" />
          </svg>
        )}
        {metric.chart === 'dots' && (
          <svg viewBox="0 0 100 40" class="w-full h-full text-accent/20" aria-hidden="true">
            <circle cx="20" cy="20" r="2" class="fill-accent md:animate-pulse" />
            <circle cx="50" cy="10" r="2" class="fill-accent md:animate-pulse" style="animation-delay: 0.2s" />
            <circle cx="80" cy="30" r="2" class="fill-accent md:animate-pulse" style="animation-delay: 0.4s" />
            <path d="M20 20 L 50 10 L 80 30" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" class="text-accent/50" />
            <circle cx="50" cy="20" r="15" class="fill-accent/5" />
          </svg>
        )}
        {metric.chart === 'line' && (
          <svg viewBox="0 0 100 40" class="w-full h-full text-accent/10" preserveAspectRatio="none" aria-hidden="true">
            <path d="M0 40 L 20 30 L 40 35 L 60 15 L 80 20 L 100 5 L 100 40 Z" fill="currentColor" />
            <path d="M0 40 L 20 30 L 40 35 L 60 15 L 80 20 L 100 5" fill="none" stroke="currentColor" stroke-width="2" class="text-accent" />
          </svg>
        )}
      </div>

      <!-- Hover gradient -->
      <div class="hidden md:block absolute inset-0 bg-gradient-to-t from-background-secondary/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
    </div>
    </div>
  ))}
</div>

<style>
  .metric-card {
    transition:
      opacity 0.5s ease-out calc(var(--i) * 100ms),
      transform 0.5s ease-out calc(var(--i) * 100ms),
      box-shadow 0.5s;
  }

  /* Set by lib/metricBento.ts only when the row starts below the fold, and
     cleared as soon as the row enters the viewport vertically. */
  [data-metrics-row][data-reveal='pending'] .metric-card {
    opacity: 0;
    transform: translateY(20px);
  }
</style>

<script>
  import '../lib/metricBento';
</script>

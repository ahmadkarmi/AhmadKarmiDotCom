---
// "Results That Speak" metrics row.
//
// Built exactly like the Lab and Insights rows on the homepage (same
// scroller, same snap wrapper and widths, same card shell as WorkCard.astro),
// because those rows swipe reliably on iPhone and every previous variant of
// this one did not: a React/framer-motion island, then static markup with a
// scroll-triggered reveal, pulse animation and hover overlay. No script, no
// custom CSS, static charts.

const metrics = [
  { value: '23%', label: 'Daily Revenue Increase', context: 'AI-driven personalization', chart: 'area' },
  { value: '90%+', label: 'Search Conversion Rate', context: 'Optimized discovery flows', chart: 'bars' },
  { value: '70%', label: 'Engagement Boost', context: 'Gamification strategies', chart: 'dots' },
  { value: '36.1%', label: 'Event Conversion', context: 'AI-driven campaigns', chart: 'line' },
];
---

<div class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-8 -mx-4 px-4 xl:grid xl:grid-cols-4 xl:gap-8 xl:pb-0 xl:mx-0 xl:px-0 no-scrollbar" data-drag-scroll>
  {metrics.map((metric, index) => (
    <div class="min-w-[85vw] sm:min-w-[70vw] md:min-w-[55vw] lg:min-w-[45vw] xl:min-w-0 snap-center">
      <article class="group relative flex flex-col h-full bg-white border border-border rounded-lg shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden hover:-translate-y-1">
        <!-- Card Header: key and context, matching WorkCard -->
        <div class="px-4 py-3 flex items-center justify-between border-b border-border/40 bg-background-secondary/5">
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4V4zm2 2v12h12V6H6z"/></svg>
            <span class="text-xs font-mono text-foreground-muted font-medium">KPI-0{index + 1}</span>
          </div>
          <span class="text-[10px] uppercase font-bold text-foreground-muted">{metric.context}</span>
        </div>

        <!-- Card Body -->
        <div class="p-4 flex flex-col h-full">
          <div class="text-4xl lg:text-5xl font-display font-bold text-accent mb-2 tracking-tight tabular-nums">
            {metric.value}
          </div>
          <h3 class="font-display font-bold text-xl text-foreground mb-4 leading-tight group-hover:text-accent transition-colors">
            {metric.label}
          </h3>

          <!-- Data viz graphic -->
          <div class="mt-auto h-16 w-full">
            {metric.chart === 'area' && (
              <svg viewBox="0 0 100 40" class="w-full h-full text-accent/20" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 35 C 20 35, 20 10, 40 10 S 60 25, 80 5 L 100 0 L 100 40 L 0 40 Z" fill="currentColor" />
                <path d="M0 35 C 20 35, 20 10, 40 10 S 60 25, 80 5 L 100 0" fill="none" stroke="currentColor" stroke-width="2" class="text-accent" />
              </svg>
            )}
            {metric.chart === 'bars' && (
              <svg viewBox="0 0 100 40" class="w-full h-full" preserveAspectRatio="none" aria-hidden="true">
                <rect x="10" y="20" width="15" height="20" class="fill-accent/20" rx="2" />
                <rect x="35" y="10" width="15" height="30" class="fill-accent/40" rx="2" />
                <rect x="60" y="15" width="15" height="25" class="fill-accent/60" rx="2" />
                <rect x="85" y="5" width="15" height="35" class="fill-accent" rx="2" />
              </svg>
            )}
            {metric.chart === 'dots' && (
              <svg viewBox="0 0 100 40" class="w-full h-full text-accent/20" aria-hidden="true">
                <circle cx="20" cy="20" r="2" class="fill-accent" />
                <circle cx="50" cy="10" r="2" class="fill-accent" />
                <circle cx="80" cy="30" r="2" class="fill-accent" />
                <path d="M20 20 L 50 10 L 80 30" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="4 4" class="text-accent/50" />
                <circle cx="50" cy="20" r="15" class="fill-accent/5" />
              </svg>
            )}
            {metric.chart === 'line' && (
              <svg viewBox="0 0 100 40" class="w-full h-full text-accent/10" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 40 L 20 30 L 40 35 L 60 15 L 80 20 L 100 5 L 100 40 Z" fill="currentColor" />
                <path d="M0 40 L 20 30 L 40 35 L 60 15 L 80 20 L 100 5" fill="none" stroke="currentColor" stroke-width="2" class="text-accent" />
              </svg>
            )}
          </div>
        </div>
      </article>
    </div>
  ))}
</div>

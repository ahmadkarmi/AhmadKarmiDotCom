<style>
  #mobile-roadmap {
    container-type: size;
    /* px per board unit, matching preserveAspectRatio="xMidYMid slice" */
    --u: max(calc(100cqw / 400), calc(100cqh / 900));
  }

  .board-static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* A layer at board box (--x, --y, --w, --h), centred like the slice. */
  .mcol {
    --ox: var(--x);
    --oy: var(--y);
    position: absolute;
    left: calc(50cqw + (var(--x) - 200) * var(--u));
    top: calc(50cqh + (var(--y) - 450) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
  }

  /* A child layer, positioned in board units relative to its column. */
  .sub {
    position: absolute;
    left: calc((var(--x) - var(--ox)) * var(--u));
    top: calc((var(--y) - var(--oy)) * var(--u));
    width: calc(var(--w) * var(--u));
    height: calc(var(--h) * var(--u));
    overflow: visible;
  }

  .fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .mticket-done {
    opacity: 0;
  }

  /* Gyro mode: JS writes each column's transform every frame. */
  :global([data-hero-mode='gyro']) .mcol {
    will-change: transform;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Loop mode (default): slow alternating drift. Starts after the headline
       has settled, and from rest, so there is no jump. */
    .mcol--todo { animation: drift-up 20s ease-in-out 1.2s infinite; }
    .mcol--progress { animation: drift-down 20s ease-in-out 1.2s infinite; }
    .mcol--done { animation: drift-up-small 20s ease-in-out 1.2s infinite; }

    :global([data-hero-mode='gyro']) .mcol {
      animation: none;
    }

    /* Ticket ships in both modes. */
    .mticket { animation: m-ticket-ship 9s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite both; }
    .mticket-base { animation: m-ticket-base 9s linear 1.2s infinite both; }
    .mticket-done { animation: m-ticket-done 9s linear 1.2s infinite both; }
    .mstack { animation: m-stack-make-room 9s cubic-bezier(0.65, 0, 0.35, 1) 1.2s infinite both; }

    :global([data-hero-paused]) #mobile-roadmap * {
      animation-play-state: paused;
    }
  }

  @keyframes drift-up {
    0%, 100% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(0, -6px, 0); }
    75% { transform: translate3d(0, 6px, 0); }
  }

  @keyframes drift-down {
    0%, 100% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(0, 6px, 0); }
    75% { transform: translate3d(0, -6px, 0); }
  }

  @keyframes drift-up-small {
    0%, 100% { transform: translate3d(0, 0, 0); }
    25% { transform: translate3d(0, -4px, 0); }
    75% { transform: translate3d(0, 4px, 0); }
  }

  /* In Progress card at y=295 moves 128 units right, 30 up, to Done's slot at y=265. */
  @keyframes m-ticket-ship {
    0% { transform: translate3d(0, 0, 0); opacity: 0; }
    6% { opacity: 1; }
    32% { transform: translate3d(0, 0, 0); }
    50% { transform: translate3d(calc(128 * var(--u)), calc(-30 * var(--u)), 0); }
    86% { transform: translate3d(calc(128 * var(--u)), calc(-30 * var(--u)), 0); opacity: 1; }
    94% { transform: translate3d(calc(128 * var(--u)), calc(-30 * var(--u)), 0); opacity: 0; }
    100% { transform: translate3d(0, 0, 0); opacity: 0; }
  }

  @keyframes m-ticket-base {
    0%, 44% { opacity: 1; }
    54%, 100% { opacity: 0; }
  }

  @keyframes m-ticket-done {
    0%, 44% { opacity: 0; }
    54%, 100% { opacity: 1; }
  }

  /* Ticket is 75 tall + 15 gap. */
  @keyframes m-stack-make-room {
    0%, 42% { transform: translate3d(0, 0, 0); }
    50%, 88% { transform: translate3d(0, calc(90 * var(--u)), 0); }
    100% { transform: translate3d(0, 0, 0); }
  }
</style>

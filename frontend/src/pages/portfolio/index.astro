---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import GridLayout from '../../components/GridLayout.astro';
import { fetchWorks } from '../../lib/wordpress';
import { graph, breadcrumbNode, personNode, PERSON_ID, SITE_URL } from '../../lib/schema';
import { absoluteUrl } from '../../lib/urls';

const works = await fetchWorks();

// Build guard: see the matching note in insights/index.astro. fetchWorks()
// returns [] on any error, so without this a WordPress outage would publish a
// live site with no portfolio and no sitemap entries.
if (works.length === 0) {
  throw new Error(
    'fetchWorks() returned no works. Refusing to build an empty /portfolio page. Check PUBLIC_WP_URL and WP credentials.'
  );
}

// JSON-LD: a CollectionPage whose mainEntity is an ItemList of every case
// study in page order, plus a breadcrumb. Mirrors the Blog node on /insights
// so both hubs hand engines a structured map of their detail pages.
const schema = graph(
  {
    '@type': 'CollectionPage',
    '@id': `${SITE_URL}/portfolio#collection`,
    url: absoluteUrl('/portfolio'),
    name: 'Portfolio of Ahmad Al-Karmi',
    description:
      'Product management, digital transformation and creative technology case studies by Ahmad Al-Karmi.',
    inLanguage: 'en',
    author: { '@id': PERSON_ID },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: works.length,
      itemListElement: works.map((work, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        url: absoluteUrl(`/portfolio/${work.slug}`),
        name: work.name,
      })),
    },
  },
  personNode(),
  breadcrumbNode([
    { name: 'Home', url: '/' },
    { name: 'Portfolio', url: '/portfolio' },
  ])
);
---

<BaseLayout
  title="Portfolio"
  description="Explore my portfolio of product management, digital transformation, and creative technology projects."
  schema={schema}
>
  <!-- Header -->
  <section class="section pt-32 pb-16">
    <div class="container-custom">
      <div class="max-w-3xl">
        <p class="text-accent font-medium mb-4">
          Portfolio
        </p>
        <h1 class="font-display text-display-lg text-foreground mb-6">
          My Work
        </h1>
        <p class="text-foreground-secondary text-lg">
          A collection of projects showcasing product management, digital strategy, branding, and creative technology solutions across various industries.
        </p>
      </div>
    </div>
  </section>

  <!-- Portfolio Grid -->
  <section class="section pt-0">
    <div class="container-custom">
      {works.length > 0 ? (
        <GridLayout>
          {works.map((work, index) => (
            <WorkCard work={work} index={index} />
          ))}
        </GridLayout>
      ) : (
        <div class="text-center py-16">
          <p class="text-foreground-muted text-lg">
            No projects available yet. Check back soon!
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

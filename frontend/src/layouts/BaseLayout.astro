            'touch @' + Math.round(t.clientX) + ',' + Math.round(t.clientY) + '\nTARGET\n   ' + chain(e.target, 7) + '\nTOP ELEMENT AT POINT\n   ' + chain(top, 3) +
            '\nSCROLLER ' + (sc ? desc(sc) + ' sw=' + sc.scrollWidth + ' cw=' + sc.clientWidth + ' ox=' + getComputedStyle(sc).overflowX + ' snap=' + getComputedStyle(sc).scrollSnapType : 'none found');
        }, { capture: true, passive: true });

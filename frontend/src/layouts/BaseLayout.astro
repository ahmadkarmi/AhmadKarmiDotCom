            ' scrollEvents=' + s.scrolls + ' scrollLeft ' + s.left0 + ' -> ' + (s.sc ? s.sc.scrollLeft : 'n/a');
          setTimeout(function () { if (s && s.sc) panel.textContent += ' (after 600ms: ' + s.sc.scrollLeft + ')'; }, 600);
        }, { capture: true, passive: true });
      })();
    </script>

